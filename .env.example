# MiMi Nox — Environment Variables
# Copy to .env and fill in. NEVER commit real values.
# All variables are optional; defaults give a fully working offline setup.

# --- Engine / Model Selection (SSOT) ---
# Provider: "ollama" (local, default) | "openai" (OpenAI-compatible API)
MIMI_MODEL_PROVIDER=ollama

# Model name (must exist on the provider)
# Ollama: gemma4:12b | OpenAI-compatible: your-model-name
MIMI_NOX_MODEL=gemma4:12b

# Base URL for the engine
# Ollama default: http://127.0.0.1:11434
# OpenAI-compatible: http://your-host:8000/v1
MIMI_NOX_BASE_URL=http://127.0.0.1:11434

# For OpenAI-compatible providers only
MIMI_OPENAI_COMPAT_MODEL=
MIMI_OPENAI_API_KEY=

# --- Offline Mode ---
# 1 = no web search, no TTS API, fully local
MIMI_NOX_OFFLINE=1

# --- Server ---
# Host and port for the FastAPI backend
MIMI_NOX_HOST=127.0.0.1
MIMI_NOX_PORT=8765

# CORS origins (comma-separated, restrict for production)
MIMI_NOX_CORS_ORIGINS=http://localhost:5174

# --- Mobile Pairing ---
# Token required for mobile clients to pair (set for public access)
MIMI_NOX_PAIRING_TOKEN=

# --- Web Search (opt-in) ---
# Set to enable web search via Crawl4AI
MIMI_NOX_WEB_SEARCH=0
CRAWL4AI_URL=http://127.0.0.1:8000

# --- TTS (opt-in) ---
MIMI_NOX_TTS=0
MIMI_NOX_TTS_PROVIDER=edge

# --- Logging ---
MIMI_NOX_LOG_LEVEL=INFO
