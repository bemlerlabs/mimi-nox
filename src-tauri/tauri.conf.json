{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiMi Nox",
  "version": "1.0.0",
  "identifier": "de.mimiai.mimi-nox",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../app",
    "beforeBuildCommand": "npm run build --prefix ../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "◑ MiMi Nox",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "focus": true,
        "url": "/"
      },
      {
        "label": "onboarding",
        "title": "MiMi Nox — Einrichtung",
        "width": 680,
        "height": 500,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' asset: https://asset.localhost data:; font-src 'self' https://fonts.gstatic.com data:; media-src 'self' https://videos.localhost",
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 620,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "De",
          "En"
        ],
        "headerImage": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/MimiTechAi/mimi-nox/releases/download/update/{{target}}-{{arch}}/{{version}}-{{target}}-{{arch}}.dmg"
      ],
      "pubkey": "dFAo6We+YRR9eEnRFxKQCxOr625n4/UOMxDKDY8qgheDSFk3iIZuEDRzH9sJ8d1i27/0+KqATMDHfE+8mJG+2w=="
    },
    "shell": {
      "open": true
    }
  }
}
