/* =========================================================
   ◑ MiMi Nox – Black Forest Edition
   Textual CSS (TCSS) – Black Forest Palette (PWA-Parität)

   MiMi Tech AI UG – Bad Liebenzell, Schwarzwald

   PWA-Palette (app/src/styles/globals.css):
     $bg-deep      #06080c   Nox Black (PWA --background)
     $surface      #0c1117   Obsidian (PWA --surface)
     $border       #1e293b   Muted border
     $text         #e8edf4   Cool White (PWA --foreground)
     $muted        #8da3b8   Dimmed (PWA --muted-foreground)
     $firefly      #42d392   Firefly Green (PWA --primary / --accent)
     $moss         #1a4d33   Moss (PWA --moss)
     $success      #22c55e   Success Green
     $amber        #ff6b35   Error / Warning
   ========================================================= */

/* ── Root ───────────────────────────────────────────────── */

App {
    background: #06080c;
}

Screen {
    background: #06080c;
    layout: vertical;
}

/* ── Brand-Header (replaces default Textual Header) ─────── */

#brand-header {
    background: #0c1117;
    border-bottom: heavy #1e293b;
    padding: 0 1;
    height: 3;
    dock: top;
    layout: horizontal;
}

#brand-mark {
    color: #42d392;
    text-style: bold;
    width: auto;
    content-align: left middle;
}

#brand-title {
    color: #e8edf4;
    text-style: bold;
    width: auto;
    content-align: left middle;
}

#brand-version {
    color: #8da3b8;
    width: auto;
    content-align: left middle;
}

#brand-tagline {
    color: #1e293b;
    text-style: italic;
    width: 1fr;
    text-align: right;
    content-align: right middle;
}

/* ── Chat View ──────────────────────────────────────────── */

#chat-view {
    background: #06080c;
    border: tall #1e293b;
    scrollbar-color: #1e293b;
    scrollbar-color-hover: #2d3a4e;
    padding: 0 1;
    height: 1fr;
}

/* ── Input Area ─────────────────────────────────────────── */

#input-area {
    height: 3;
    background: #0c1117;
    border: tall #1e293b;
    padding: 0 1;
}

#input-area.command-mode {
    border: tall #42d392;
    background: #0a1a12;
}

#chat-input {
    background: #06080c;
    color: #e8edf4;
    border: none;
    height: 1;
    width: 1fr;
}

#chat-input:focus {
    border: none;
    background: #06080c;
}

/* ── Command Hint ───────────────────────────────────────── */

#command-hint {
    height: 1;
    background: #0c1117;
    color: #8da3b8;
    padding: 0 1;
    display: none;
}

#command-hint.visible {
    display: block;
}

/* ── Status Bar ─────────────────────────────────────────── */

#status-bar {
    height: 1;
    background: #0c1117;
    color: #8da3b8;
    dock: bottom;
    padding: 0 1;
    layout: horizontal;
    border-top: heavy #1e293b;
}

#status-bar.streaming {
    background: #0a1a12;
    color: #42d392;
}

#status-bar.error {
    background: #1a0a0a;
    color: #ff6b35;
}

#status-indicator {
    width: auto;
    color: #22c55e;
}

#status-indicator.offline {
    color: #ff6b35;
}

#status-indicator.streaming {
    color: #42d392;
}

#status-model {
    width: auto;
    color: #8da3b8;
    padding: 0 1;
}

#status-provider {
    width: auto;
    color: #42d392;
    padding: 0 1;
    text-style: bold;
}

#status-tagline {
    width: 1fr;
    color: #1e293b;
    text-align: right;
}

/* ── Scrollbar ──────────────────────────────────────────── */

ScrollableContainer > ScrollBar {
    background: #06080c;
    color: #1e293b;
}

/* ── Welcome / System Messages ──────────────────────────── */

.welcome {
    color: #8da3b8;
    text-style: italic;
}

.system-msg {
    color: #8da3b8;
}

.error-msg {
    color: #ff6b35;
    text-style: bold;
}

/* ── Fallback / Tool hints ──────────────────────────────── */

.fallback-hint {
    color: #8da3b8;
    text-style: italic;
}

.tool-call {
    color: #42d392;
    text-style: italic;
}

.tool-done {
    color: #22c55e;
}

/* ── Footer ─────────────────────────────────────────────── */

Footer {
    background: #06080c;
    color: #8da3b8;
    border-top: heavy #1e293b;
}
