# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environment
.venv/
venv/
env/

# Distribution
dist/
build/
*.egg-info/
*.egg

# Pytest
.pytest_cache/
.benchmarks/
.coverage
.coverage*
coverage.xml
htmlcov/

# Other Python tool caches
.mypy_cache/
.ruff_cache/
.pyre_cache/
.hypothesis/
.pip_cache/
.cache/

# Generated README media work files
docs/media/frames/

# JavaScript dependencies
node_modules/

# Local databases and SQLite sidecars
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Session data (user-specific)
.clawdash/

# Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Environment & secrets — NEVER commit real values
# (.env.example / .env.example.* are intentionally tracked via negation)
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.example.*
*.key
*.pem
*.p12
*.pfx
*_rsa
*_rsa.pub

# Hygiene: backups, stale configs, build artifacts, generated docs
app-backup-vanilla/
*.bak
*.tsbuildinfo
miminox-data/
training/
docs/*.png
docs/*.pdf
docs/*.html
STATUS_REPORT.md
CORE_STATUS_REPORT.md
STATUS_REPORT_NeMo_RL.md
app/STATUS-REPORT.md

# Local runtime data (root-level, mirrors app/.gitignore)
.mimi-nox/

# Logs (root-level)
*.log
logs/

# Kanban-Worktrees (lokal, nie committen)
.worktrees/

# Test-Suite (lokal-only, nicht Teil des öffentlichen Open-Source-Repos)
# Leading slash = nur die Root-`tests/`; `app/tests/` (Playwright) bleibt tracked.
/tests/
scripts/run-tests.sh
